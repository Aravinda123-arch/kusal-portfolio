# ==============================================================================
# Portfolio Contact Form Email Delivery Configuration
# ==============================================================================
# Copy this file to .env.local and populate with your credentials.
# The contact form will deliver inquiries directly to CONTACT_TO_EMAIL.

# Recipient email address where visitor messages are sent:
CONTACT_TO_EMAIL=Kusalaravinda2004@gmail.com

# ------------------------------------------------------------------------------
# Option 1: Standard SMTP (e.g. Gmail App Password, Brevo, SendGrid, Mailgun)
# ------------------------------------------------------------------------------
# For Gmail:
# 1. Go to Google Account (myaccount.google.com) -> Security.
# 2. Ensure 2-Step Verification is turned ON.
# 3. Under 2-Step Verification, generate an 16-character "App Password".
# 4. Paste that 16-character password into SMTP_PASS (without spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=Kusalaravinda2004@gmail.com
SMTP_PASS=your_16_character_app_password
CONTACT_FROM_EMAIL="Kusal Portfolio" <Kusalaravinda2004@gmail.com>

# ------------------------------------------------------------------------------
# Option 2: Resend API (Alternative Modern Transactional Email)
# ------------------------------------------------------------------------------
# Get your free API key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL="Portfolio Contact" <onboarding@resend.dev>
